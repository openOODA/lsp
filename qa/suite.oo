// # Test LSP Server — Run LSP QA Probes Twice
//
// Logline: Run each lsp qa probe twice in fresh processes under the primary compiler. Fail closed on miss.
//
// Setup: Double-run identity law for LSP server probes. Compiler resolves with zero user config.
//
// Beats:
//   1. Resolve primary compiler binary (OODA_COMPILER, OODA_TOOLCHAIN, HOME).
//   2. Enumerate qa/probe_*.oo from the filesystem (never a hardcoded list);
//      fail closed if no probes are found under qa/.
//   3. Compile and execute each probe twice in fresh processes.
//   4. Clean up temporary probe binaries immediately.
//   5. Report every failure; exit 0 only when all probes pass both runs.

import "std/fs/process/env.oo";
import "std/fs/file/glob.oo";
import "std/core/text/natural_sort.oo";

fn run_probe_once(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let tmp_bin: String = path + ".tmp.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("exec fail " + path + ": " + e);
    }
    return Ok(0);
}

fn run_probe_twice(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let r1: Result[Int, String] = run_probe_once(p, oodac, path);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_probe_once(p, oodac, path);
    if r2.is_err() { return r2; }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }

    let p1: List[String] = glob_scan_dir(fs_r, "qa/protocol", "probe_*.oo");
    let p2: List[String] = glob_scan_dir(fs_r, "qa/features", "probe_*.oo");
    let p3: List[String] = glob_scan_dir(fs_r, "qa/symbols", "probe_*.oo");
    let p4: List[String] = glob_scan_dir(fs_r, "qa/sync", "probe_*.oo");
    let p5: List[String] = glob_scan_dir(fs_r, "qa/ops", "probe_*.oo");
    let mut combined: List[String] = list_new();
    let mut gi: Int = 0;
    while gi < list_len(p1) {
        combined = list_push(combined, list_get(p1, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(p2) {
        combined = list_push(combined, list_get(p2, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(p3) {
        combined = list_push(combined, list_get(p3, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(p4) {
        combined = list_push(combined, list_get(p4, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(p5) {
        combined = list_push(combined, list_get(p5, gi));
        gi = gi + 1;
    }
    let ps: List[String] = natural_sort_list(combined);
    if list_len(ps) == 0 {
        return Err("no probes discovered under qa/");
    }
    println("lsp suite: enumerated " + list_len(ps).to_string() + " probes");

    let mut failed: Int = 0;
    let mut first_err: String = "";
    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path);
        if r.is_err() {
            let m: String = match r { Ok(_) => "", Err(e) => e };
            println("lsp suite FAIL: " + m);
            if failed == 0 { first_err = m; }
            failed = failed + 1;
        } else {
            println("  Passed " + path);
        }
        i = i + 1;
    }
    if failed != 0 {
        println("lsp test suite: " + failed.to_string() + " probe(s) failed");
        return Err(first_err);
    }
    println("lsp test suite: ALL PROBES PASSED (double-run identical)");
    return Ok(0);
}
