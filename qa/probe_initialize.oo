// # LSP Initialize - Hostile Probe
//
// Logline: Proves the advertised capabilities object and engine version. URI guards are in probe_uri.oo.
//
// Setup: Imports only capabilities and version. No session structs.
//
// Beats:
//   1. Incremental sync, resolve, signature, refs, rename, tokens, folders, watch.
//   2. resolveProvider is true. change is 2.
//   3. lsp_facade_version equals 2.12.0.

import "lsp/server/lsp_server_capabilities.oo";
import "lsp/server/lsp_version.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let caps: String = lsp_server_capabilities_object();
    if str_index_of(caps, "hoverProvider") < 0 { fail("missing hoverProvider"); }
    if str_index_of(caps, "\"openClose\":true") < 0 { fail("missing openClose"); }
    if str_index_of(caps, "\"change\":2") < 0 { fail("incremental change"); }
    if str_index_of(caps, "\"resolveProvider\":true") < 0 { fail("resolveProvider"); }
    if str_index_of(caps, "signatureHelpProvider") < 0 { fail("signatureHelp"); }
    if str_index_of(caps, "referencesProvider") < 0 { fail("references"); }
    if str_index_of(caps, "renameProvider") < 0 { fail("rename"); }
    if str_index_of(caps, "semanticTokensProvider") < 0 { fail("tokens"); }
    if str_index_of(caps, "workspaceFolders") < 0 { fail("folders"); }
    if str_index_of(caps, "didChangeWatchedFiles") < 0 { fail("watch"); }
    if str_index_of(caps, "documentRangeFormattingProvider") < 0 { fail("range format"); }
    if str_index_of(caps, "workspaceSymbolProvider") < 0 { fail("workspace symbol"); }
    let ver: String = lsp_facade_version();
    if ver != "2.12.0" { fail("version drift: " + ver); }
    println("PASS initialize capabilities v=" + ver);
    println("probe_initialize PASSED");
}
