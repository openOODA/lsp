// # LSP Completion - Hostile Probe
//
// Logline: Proves prefix completion returns FsReadCap and refuses an unknown prefix with an empty items array.
//
// Setup: Canonical index only. No filesystem.
//
// Beats:
//   1. Prefix Fs yields FsReadCap in the JSON items list.
//   2. Prefix Zzzq yields zero items, not a stub default.
//   3. Two runs of the same prefix are byte-identical.

import "lsp/symbols/lsp_symbol_canonical.oo";
import "lsp/methods/lsp_completion_codec.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let idx: List[String] = lsp_index_build_canonical();
    let recs: List[String] = lsp_index_prefix(idx, "Fs");
    if list_len(recs) < 1 { fail("Fs prefix empty"); }
    let json: String = lsp_index_records_to_completion_json(recs);
    if str_index_of(json, "FsReadCap") < 0 { fail("FsReadCap missing: " + json); }
    if str_index_of(json, "HttpCap") >= 0 { fail("HttpCap must be dead"); }
    if str_index_of(json, "UnsafeFFICap") >= 0 { fail("UnsafeFFICap must be dead"); }
    println("PASS Fs prefix");
    let all: String = lsp_index_records_to_completion_json(idx);
    if str_index_of(all, "FfiCap") < 0 { fail("FfiCap missing from seed"); }
    if str_index_of(all, "HttpCap") >= 0 { fail("HttpCap must be dead"); }
    println("PASS seed names");

    let none: List[String] = lsp_index_prefix(idx, "Zzzq");
    if list_len(none) != 0 { fail("unknown prefix must be empty"); }
    let empty_json: String = lsp_index_records_to_completion_json(none);
    if chars_len(empty_json) != 0 { fail("empty list must encode as empty string"); }
    println("PASS unknown prefix empty");

    let j2: String = lsp_index_records_to_completion_json(lsp_index_prefix(idx, "Fs"));
    if json != j2 { fail("completion not deterministic"); }
    println("PASS completion deterministic");
    println("probe_completion PASSED");
}
