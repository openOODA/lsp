// # LSP E-M Cache Probe
//
// Logline: Proves .em module header signature parsing, in-memory caching, and sub-millisecond jump-to-definition resolution.
//
// Setup: Pure in-memory probe. Fails closed on missing symbols, incorrect line coordinates, or non-determinism.
//
// Beats:
//   1. Parse sample .em header containing functions, structs, and capabilities.
//   2. Assert module symbol table preserves export coordinates.
//   3. Assert LspEmCache fast lookup returns exact Location JSON.
//   4. Assert double-run determinism: Run_1 == Run_2.

import "lsp/bridge/lsp_compiler_types.oo";
import "lsp/bridge/lsp_em_cache.oo";

fn sample_em_content() -> String {
    let mut s: String = "# EM-MODULE v1 (EM01)\n";
    s = s + "module: blackbox/autopsy/report_formatter.oo\n";
    s = s + "hash: 12345678\n";
    s = s + "EXPORTS:\n";
    s = s + "EXPORT fn autopsy_format_from_json 107 0\n";
    s = s + "EXPORT fn autopsy_format_from_json_compact 110 0\n";
    s = s + "EXPORT struct AutopsyData 20 0\n";
    s = s + "EXPORT cap FsReadCap 15 0\n";
    s = s + "BYTECODE:\n";
    s = s + "OP_MODULE blackbox/autopsy/report_formatter.oo\n";
    return s;
}

pub fn probe_em_cache_run() -> Result[Int, String] {
    let em: String = sample_em_content();
    let tbl: LspModuleSymbolTable = lsp_em_parse_header(em);

    if tbl.uri != "blackbox/autopsy/report_formatter.oo" {
        return Err("probe_em_cache: module URI mismatch");
    }
    if list_len(tbl.functions) != 2 {
        return Err("probe_em_cache: expected 2 functions");
    }
    if list_len(tbl.structs) != 1 {
        return Err("probe_em_cache: expected 1 struct");
    }
    if list_len(tbl.capabilities) != 1 {
        return Err("probe_em_cache: expected 1 capability");
    }

    let mut cache: LspEmCache = lsp_em_cache_new();
    lsp_em_cache_put(&mut cache, tbl.uri, "12345678", tbl);

    if lsp_em_cache_count(&cache) != 1 {
        return Err("probe_em_cache: expected cache count 1");
    }

    let loc_fn: String = lsp_em_cache_lookup_symbol(&cache, "autopsy_format_from_json_compact");
    if str_index_of(loc_fn, "report_formatter.oo") < 0 {
        return Err("probe_em_cache: missing uri in lookup");
    }
    if str_index_of(loc_fn, "\"line\":110") < 0 {
        return Err("probe_em_cache: incorrect line number in lookup");
    }

    let loc_st: String = lsp_em_cache_lookup_symbol(&cache, "AutopsyData");
    if str_index_of(loc_st, "\"line\":20") < 0 {
        return Err("probe_em_cache: struct lookup failed");
    }

    let loc_missing: String = lsp_em_cache_lookup_symbol(&cache, "NonExistentSymbol");
    if chars_len(loc_missing) != 0 {
        return Err("probe_em_cache: missing symbol must return empty string");
    }

    // Double-run determinism
    let tbl2: LspModuleSymbolTable = lsp_em_parse_header(em);
    let mut cache2: LspEmCache = lsp_em_cache_new();
    lsp_em_cache_put(&mut cache2, tbl2.uri, "12345678", tbl2);
    let loc_fn2: String = lsp_em_cache_lookup_symbol(&cache2, "autopsy_format_from_json_compact");
    if loc_fn != loc_fn2 {
        return Err("probe_em_cache: double-run determinism failure");
    }

    return Ok(0);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let r: Result[Int, String] = probe_em_cache_run();
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        println("FAIL: probe_em_cache: " + e);
        return r;
    }
    println("PASS: probe_em_cache");
    return Ok(0);
}
