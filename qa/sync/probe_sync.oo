// # LSP Incremental Sync - Hostile Probe
//
// Logline: Proves ranged contentChanges replace a span and a missing range replaces the file.
//
// Setup: Pure apply. No dispatcher.
//
// Beats:
//   1. Replace columns 2-4 of hello with y → heyo.
//   2. A change without range is a full document replace.
//   3. Two ranged edits apply in order.

import "lsp/methods/lsp_sync.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let ch: String = "[{\"range\":{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":4}},\"text\":\"y\"}]";
    let a: String = lsp_sync_apply_changes("hello", ch);
    if a != "heyo" { fail("range: [" + a + "]"); }
    println("PASS range");

    let full: String = "[{\"text\":\"abc\"}]";
    let b: String = lsp_sync_apply_changes("zzzz", full);
    if b != "abc" { fail("full: [" + b + "]"); }
    println("PASS full");

    let two: String = "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"text\":\"H\"},{\"range\":{\"start\":{\"line\":0,\"character\":4},\"end\":{\"line\":0,\"character\":5}},\"text\":\"O\"}]";
    let c: String = lsp_sync_apply_changes("hello", two);
    if c != "HellO" { fail("two: [" + c + "]"); }
    println("PASS ordered");

    let mr: List[String] = lsp_sync_apply_changes_merkle("hello", two);
    let m_doc: String = list_get(mr, 0);
    let m_root: String = list_get(mr, 1);
    if m_doc != "HellO" { fail("merkle doc: [" + m_doc + "]"); }
    if chars_len(m_root) != 64 { fail("merkle root len != 64"); }
    let exp_root: String = lsp_merkle_compute_doc("HellO");
    if m_root != exp_root { fail("merkle root mismatch"); }
    if !lsp_sync_ast_cache_check(m_root, "HellO") { fail("ast cache hit expected"); }
    if lsp_sync_ast_cache_check(m_root, "different") { fail("ast cache miss expected"); }
    println("PASS merkle");
    println("PASS ast cache");
    println("probe_sync PASSED");
}

