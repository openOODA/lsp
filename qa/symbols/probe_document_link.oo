// # LSP DocumentLink - Hostile Probe
//
// Logline: Proves &Cap links resolve from loaded cap rows and empty rows yield none.
//
// Setup: In-memory rows. No filesystem.
//
// Beats:
//   1. &FsReadCap with a row becomes a DocumentLink target under oodar_root.
//   2. Empty rows yield [].
//   3. A name that is not a cap ref yields [].

import "lsp/methods/lsp_document_link.oo";
import "lsp/symbols/lsp_cap_table.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let mut rows: List[String] = lsp_cap_table_empty();
    rows = list_push(rows, "FsReadCap|fs/os/fs.c");
    let src: String = "fn f(fs: &FsReadCap) {}\n";
    let links: String = lsp_document_link_find(src, rows, "oodar");
    if str_index_of(links, "oodar/fs/os/fs.c") < 0 { fail("link target: " + links); }
    println("PASS cap link");

    let none: String = lsp_document_link_find(src, lsp_cap_table_empty(), "oodar");
    if none != "[]" { fail("empty rows must be []: " + none); }
    let plain: String = lsp_document_link_find("let x = 1;\n", rows, "oodar");
    if plain != "[]" { fail("no cap ref must be []: " + plain); }
    println("PASS empty");
    println("probe_document_link PASSED");
}
