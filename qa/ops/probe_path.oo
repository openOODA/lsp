// # LSP Path Guard Probe
//
// Logline: Proves lsp_script_path_ok rejects traversal.
//
// Setup: No Fs caps. Pure path checks.
//
// Beats:
//   1. A `..` path is rejected.
//   2. Relative lsp/server and lsp/methods paths pass.
//   3. A simple `a.oo` name passes.
import "lsp/qa/lsp_script_path.oo";

pub fn main() -> Result[Int, String] {
    if lsp_script_path_ok("../evil.oo") { return Err("traversal must fail"); }
    if lsp_script_path_ok("lsp/server/lsp_server.oo") == false { return Err("server must pass"); }
    if lsp_script_path_ok("lsp/methods/lsp_completion_codec.oo") == false { return Err("methods must pass"); }
    if !lsp_script_path_ok("a.oo") { return Err("a.oo must pass"); }
    println("probe: path ok");
    return Ok(0);
}
