// # LSP Diagnostics - Hostile Probe
//
// Logline: Proves E_EM_WEIGHT, E_EM_PINS, and E_EM_PS emit, and a short clean file emits none of those codes.
//
// Setup: Pure converters. No filesystem.
//
// Beats:
//   1. 300 lines emit E_EM_WEIGHT. 3 lines do not.
//   2. A Floor: header pin emits E_EM_PINS.
//   3. W=0 emits E_EM_PS. A clean short file has an empty diagnostic concat.

import "lsp/methods/lsp_diagnostics.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn many_lines(n: Int) -> String {
    let mut s: String = "";
    let mut i: Int = 0;
    while i < n {
        s = s + "x\n";
        i = i + 1;
    }
    return s;
}

pub fn main() {
    let heavy: String = lsp_diag_weight_to_diagnostic(300);
    if str_index_of(heavy, "E_EM_WEIGHT") < 0 { fail("300 lines must warn: " + heavy); }
    let light: String = lsp_diag_weight_to_diagnostic(3);
    if chars_len(light) != 0 { fail("3 lines must be clean: " + light); }
    println("PASS weight");

    let pins: String = lsp_diag_pins_to_diagnostic("// Floor: 1\n");
    if str_index_of(pins, "E_EM_PINS") < 0 { fail("Floor pin missing"); }
    let nopin: String = lsp_diag_pins_to_diagnostic("pub fn x() {}\n");
    if chars_len(nopin) != 0 { fail("clean file must have no pins"); }
    println("PASS pins");

    let ps0: String = lsp_diag_ps_to_diagnostic(100, 20, 0, 10);
    if str_index_of(ps0, "E_EM_PS") < 0 { fail("W=0 must fail-closed"); }
    println("PASS ps W=0");

    let clean: String = lsp_server_extract_diags("file:///tmp/a.oo", "pub fn x() {}\n");
    if str_index_of(clean, "E_EM_WEIGHT") >= 0 { fail("clean file weight: " + clean); }
    if str_index_of(clean, "E_EM_PINS") >= 0 { fail("clean file pins: " + clean); }
    println("PASS clean extract");

    let close: String = lsp_server_handle_did_close("file:///tmp/a.oo");
    if str_index_of(close, "publishDiagnostics") < 0 { fail("didClose must publish"); }
    if str_index_of(close, "\"diagnostics\":[]") < 0 { fail("didClose must clear"); }
    println("PASS didClose");
    println("probe_diagnostics PASSED");
}
