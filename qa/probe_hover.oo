// # LSP Hover - Hostile Probe
//
// Logline: Proves hover renders a known symbol and returns JSON null for an unknown symbol.
//
// Setup: Canonical index. Academy parse only when the source contains a header before pub fn.
//
// Beats:
//   1. Hover on FsReadCap returns a markdown contents block.
//   2. Hover on an unknown name returns result null.
//   3. Two hovers on the same symbol are byte-identical.

import "lsp/symbols/lsp_symbol_canonical.oo";
import "lsp/methods/lsp_hover.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let idx: List[String] = lsp_index_build_canonical();
    let h1: String = lsp_hover_from_index(idx, "FsReadCap", "1", 0, 0, "");
    if str_index_of(h1, "markdown") < 0 { fail("hover missing markdown: " + h1); }
    if str_index_of(h1, "FsReadCap") < 0 { fail("hover missing symbol"); }
    println("PASS known hover");

    let h2: String = lsp_hover_from_index(idx, "NotASymbol", "1", 0, 0, "");
    if str_index_of(h2, "\"result\":null") < 0 { fail("unknown hover must be null: " + h2); }
    println("PASS unknown hover null");

    let src: String = "// # Title\n//\n// Logline: Demo function.\n//\n// Setup: None.\n//\n// Beats:\n//   1. Return.\n\npub fn hello() -> String { return \"hi\"; }\n";
    let idx2: List[String] = lsp_index_add(idx, "hello", "Function", "pub fn hello()", "demo");
    let h3: String = lsp_hover_from_index(idx2, "hello", "2", 8, 0, src);
    if str_index_of(h3, "Title") < 0 { fail("academy title missing: " + h3); }
    let h4: String = lsp_hover_from_index(idx2, "hello", "2", 8, 0, src);
    if h3 != h4 { fail("hover not deterministic"); }
    println("PASS academy hover deterministic");
    println("probe_hover PASSED");
}
