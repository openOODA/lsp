// # LSP Semantic Tokens - Hostile Probe
//
// Logline: Proves comments, strings, keywords, and fn names are encoded in the delta array.
//
// Setup: Pure scanner. No dispatcher.
//
// Beats:
//   1. A // comment emits token type 17.
//   2. A string emits 18. `fn` emits 15. The ident after fn emits 12.

import "lsp/methods/lsp_semantic.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let d: String = lsp_semantic_data("// x\npub fn hello() { let y = \"z\"; }\n");
    if str_index_of(d, ",17,0") < 0 { fail("comment: " + d); }
    if str_index_of(d, ",15,0") < 0 { fail("keyword: " + d); }
    if str_index_of(d, ",12,0") < 0 { fail("function: " + d); }
    if str_index_of(d, ",18,0") < 0 { fail("string: " + d); }
    println("PASS token types");
    println("probe_semantic PASSED");
}
