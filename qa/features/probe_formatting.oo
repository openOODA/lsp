// # LSP Formatting - Hostile Probe
//
// Logline: Proves trailing whitespace is stripped, tabs become 4 spaces, and the handler returns a TextEdit.
//
// Setup: Pure string transforms. No filesystem.
//
// Beats:
//   1. Trailing spaces and tabs on a line are removed.
//   2. A tab character becomes four spaces.
//   3. The formatting handler returns a non-empty newText edit.

import "lsp/methods/lsp_formatting.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    let stripped: String = lsp_formatting_strip_trailing_ws("abc  \nxyz\t\n");
    if stripped != "abc\nxyz\n" { fail("strip: [" + stripped + "]"); }
    println("PASS strip trailing");

    let tabs: String = lsp_formatting_expand_tabs("a\tb");
    if tabs != "a    b" { fail("tabs: [" + tabs + "]"); }
    println("PASS expand tabs");

    let mid: String = lsp_formatting_expand_tabs(lsp_formatting_strip_trailing_ws("a\tb  \n"));
    if mid != "a    b\n" { fail("format combo: [" + mid + "]"); }
    let framed: String = lsp_formatting_handle_formatting("1", "file:///tmp/a.oo", "a\tb  \n");
    if str_index_of(framed, "newText") < 0 { fail("handler missing newText: " + framed); }
    println("PASS formatting handler");

    let rng: String = lsp_formatting_handle_range("2", "ab\tc  \nxy\n", 0, 0, 1, 0);
    if str_index_of(rng, "ab    c") < 0 { fail("range format: " + rng); }
    println("PASS range format");
    println("probe_formatting PASSED");
}
