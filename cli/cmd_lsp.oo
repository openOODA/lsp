// # Sovereign ooda lsp CLI command with stdio JSON-RPC
//
// Logline: Wires the native openOODA LSP engine into `ooda lsp` over standard stdio JSON-RPC.
//
// Setup: Uses the native lsp_stdio loop. No temp files, no shell subprocesses, no Node.js/npm.
//
// Beats:
//   1. Parse --stdio, --stdlib-root, --oodar-root, and an optional request file path from argv.
//   2. In file mode, read a complete LSP wire frame and dispatch one request.
//   3. In --stdio mode, run the native lsp_serve loop until shutdown/exit/EOF.
//   4. Frame engine replies with Content-Length headers.

import "wire/lsp_stdio.oo";

fn cmd_lsp_arg_flag(args: List[String], flag: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == flag { return true; }
        i = i + 1;
    }
    return false;
}

fn cmd_lsp_arg_value(args: List[String], flag: String) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i + 1 < n {
        if list_get(args, i) == flag { return list_get(args, i + 1); }
        i = i + 1;
    }
    return "";
}

fn cmd_lsp_arg_positional(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if !str_starts_with(a, "-") { return a; }
        if a == "--stdlib-root" && i + 1 < n { i = i + 1; }
        if a == "--oodar-root" && i + 1 < n { i = i + 1; }
        i = i + 1;
    }
    return "";
}

pub fn run_ooda_lsp(fr: &FsReadCap, env: &EnvCap, sys: &SysCap, args: List[String]) {
    let explicit_root: String = cmd_lsp_arg_value(args, "--stdlib-root");
    let oodar_root: String = cmd_lsp_arg_value(args, "--oodar-root");
    let path: String = cmd_lsp_arg_positional(args);
    let use_stdio: Bool = cmd_lsp_arg_flag(args, "--stdio") || path == "";

    if !use_stdio {
        if !path_exists(fr, path) {
            println("ERR\tlsp\tunreadable file: " + path);
            process_exit(2);
        }
        let rawr: Result[String, String] = read_file(fr, path);
        if !rawr.is_ok() {
            println("ERR\tlsp\tcannot read " + path);
            process_exit(1);
        }
        let raw: String = match rawr { Ok(s) => s, Err(m) => m };
        let reply: String = lsp_serve_buffer(fr, env, explicit_root, oodar_root, raw);
        if chars_len(reply) > 0 { println(reply); }
        return;
    }

    lsp_serve(fr, env, explicit_root, oodar_root);
}
