// # LSP DocumentLink for Capability Tokens
//
// Logline: Scans source for &Cap references and returns DocumentLink targets from the loaded cap table.
//
// Setup: Uses lsp_definition_builtin_path. Empty cap rows yield an empty link list. No hard-coded paths.
//
// Beats:
//   1. Walk the source and collect &Ident spans.
//   2. Resolve each ident through the loaded cap table.
//   3. Frame a JSON-RPC response with the DocumentLink array.

import "lsp_definition.oo";
import "lsp_text.oo";
import "lsp/wire/lsp_jsonrpc.oo";

pub fn lsp_document_link_find(src: String, rows: List[String], oodar_root: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut line: Int = 0;
    let mut col: Int = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "&" {
            let start_col: Int = col;
            let mut j: Int = i + 1;
            let mut j_col: Int = col + lsp_text_utf16_width(c);
            while j < n {
                if !lsp_text_is_ident_char(char_at(src, j)) { break; }
                j_col = j_col + lsp_text_utf16_width(char_at(src, j));
                j = j + 1;
            }
            if j > i + 1 {
                let name: String = str_slice(src, i + 1, j);
                let path: String = lsp_definition_builtin_path(name, rows, oodar_root);
                if chars_len(path) > 0 {
                    if chars_len(out) > 0 { out = out + ","; }
                    let p: String = lsp_jsonrpc_escape(path);
                    out = out + "{\"range\":{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + start_col.to_string() + "},\"end\":{\"line\":" + line.to_string() + ",\"character\":" + j_col.to_string() + "}},\"target\":\"" + p + "\"}";
                }
                i = j;
                col = j_col;
                continue;
            }
        }
        if c == "\n" { line = line + 1; col = 0; } else { col = col + lsp_text_utf16_width(c); }
        i = i + 1;
    }
    return "[" + out + "]";
}

pub fn lsp_document_link_handle(id: String, src: String, rows: List[String], oodar_root: String) -> String {
    let links: String = lsp_document_link_find(src, rows, oodar_root);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, links));
}
