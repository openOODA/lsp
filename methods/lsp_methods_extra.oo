// # LSP Server Extras — DocumentLink, InlayHint, ExecuteCommand
//
// Logline: Hosts the 3 additional LSP method handlers that the core dispatcher in lsp_server_dispatch.oo delegates to, keeping the dispatcher file under the 256-line cap.
//
// Setup: Pure string codec helpers, no external capability required. Importers: lsp_server_dispatch.oo (calls lsp_extras_handle_* on the dispatcher hot path).
//
// Beats:
//   1. Scan source text for `&Cap` references; return a DocumentLink list with target URIs from lsp_definition.oo's canonical path table.
//   2. Scan source text for `let x = <literal>` and emit InlayHint with the inferred literal type (String, Int, Bool).
//   3. Match known executeCommand names (ooda.lsp.version, ooda.lsp.indexSize, ooda.lsp.echo) and return results; unknown commands return -32601.

import "lsp/server/lsp_version.oo";
import "lsp_definition.oo";
import "lsp_text.oo";

pub fn lsp_extras_byte_is_word(b: Int) -> Bool {
    if b >= 65 && b <= 90 { return true; }
    if b >= 97 && b <= 122 { return true; }
    if b >= 48 && b <= 57 { return true; }
    if b == 95 { return true; }
    return false;
}

pub fn lsp_extras_text_find_links(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut line: Int = 0;
    let mut col: Int = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "&" {
            let start_col: Int = col;
            let mut j: Int = i + 1;
            let mut j_col: Int = col;
            while j < n {
                let bj: Int = byte_at(char_at(src, j), 0);
                if !lsp_extras_byte_is_word(bj) { break; }
                j = j + 1;
                j_col = j_col + 1;
            }
            if j > i + 1 {
                let name: String = str_slice(src, i + 1, j);
                let path: String = lsp_definition_builtin_path(name);
                if chars_len(path) > 0 {
                    if chars_len(out) > 0 { out = out + ","; }
                    let p: String = lsp_jsonrpc_escape(path);
                    out = out + "{\"range\":{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + start_col.to_string() + "},\"end\":{\"line\":" + line.to_string() + ",\"character\":" + j_col.to_string() + "}},\"target\":\"" + p + "\"}";
                }
                i = j;
                col = j_col;
                continue;
            }
        }
        if c == "\n" { line = line + 1; col = 0; } else { col = col + 1; }
        i = i + 1;
    }
    return "[" + out + "]";
}

pub fn lsp_extras_text_find_inlay_hints(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut line: Int = 0;
    let mut col: Int = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "=" && i + 1 < n {
            let prev: String = if i > 0 { char_at(src, i - 1) } else { "" };
            if prev != "=" {
                let next: String = char_at(src, i + 1);
                if next == " " || next == "\t" {
                    let mut k: Int = i + 1;
                    let mut k_col: Int = col + 1;
                    while k < n && (char_at(src, k) == " " || char_at(src, k) == "\t") { k = k + 1; k_col = k_col + 1; }
                    if k < n {
                        let first: String = char_at(src, k);
                        let mut hint: String = "";
                        if first == "\"" { hint = "String"; }
                        else if lsp_text_is_digit(first) { hint = "Int"; }
                        else if str_starts_with(str_slice(src, k, n), "true") { hint = "Bool"; }
                        else if str_starts_with(str_slice(src, k, n), "false") { hint = "Bool"; }
                        if chars_len(hint) > 0 {
                            if chars_len(out) > 0 { out = out + ","; }
                            out = out + "{\"position\":{\"line\":" + line.to_string() + ",\"character\":" + k_col.to_string() + "},\"label\":\": " + hint + "\",\"kind\":1}";
                        }
                    }
                }
            }
        }
        if c == "\n" { line = line + 1; col = 0; } else { col = col + 1; }
        i = i + 1;
    }
    return "[" + out + "]";
}

pub fn lsp_extras_handle_document_link(id: String, src: String) -> String {
    let links: String = lsp_extras_text_find_links(src);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, links));
}

pub fn lsp_extras_handle_inlay_hint(id: String, src: String) -> String {
    let hints: String = lsp_extras_text_find_inlay_hints(src);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, hints));
}

pub fn lsp_extras_handle_execute_command(id: String, idx: List[String], command: String, args_json: String) -> String {
    if command == "ooda.lsp.version" { return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, lsp_facade_version())); }
    if command == "ooda.lsp.indexSize" { return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, list_len(idx).to_string())); }
    if command == "ooda.lsp.echo" { return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, args_json)); }
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32601, "Unknown command: " + command));
}
