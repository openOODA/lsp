// # LSP InlayHint for Literal Lets
//
// Logline: Emits type inlay hints for `let x = <literal>` with String, Int, or Bool.
//
// Setup: Pure text scan. No capability required.
//
// Beats:
//   1. Find `=` followed by a string, digit, true, or false literal.
//   2. Emit an InlayHint with kind=1 (Type).
//   3. Frame a JSON-RPC response with the hint array.

import "lsp_text.oo";
import "lsp/wire/lsp_jsonrpc.oo";

pub fn lsp_inlay_hint_find(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut line: Int = 0;
    let mut col: Int = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "=" && i + 1 < n {
            let prev: String = if i > 0 { char_at(src, i - 1) } else { "" };
            if prev != "=" {
                let next: String = char_at(src, i + 1);
                if next == " " || next == "\t" {
                    let mut k: Int = i + 1;
                    let mut k_col: Int = col + 1;
                    while k < n && (char_at(src, k) == " " || char_at(src, k) == "\t") {
                        k = k + 1;
                        k_col = k_col + 1;
                    }
                    if k < n {
                        let first: String = char_at(src, k);
                        let mut hint: String = "";
                        if first == "\"" { hint = "String"; }
                        else if lsp_text_is_digit(first) { hint = "Int"; }
                        else if str_starts_with(str_slice(src, k, n), "true") { hint = "Bool"; }
                        else if str_starts_with(str_slice(src, k, n), "false") { hint = "Bool"; }
                        if chars_len(hint) > 0 {
                            if chars_len(out) > 0 { out = out + ","; }
                            out = out + "{\"position\":{\"line\":" + line.to_string() + ",\"character\":" + k_col.to_string() + "},\"label\":\": " + hint + "\",\"kind\":1}";
                        }
                    }
                }
            }
        }
        if c == "\n" { line = line + 1; col = 0; } else { col = col + 1; }
        i = i + 1;
    }
    return "[" + out + "]";
}

pub fn lsp_inlay_hint_handle(id: String, src: String) -> String {
    let hints: String = lsp_inlay_hint_find(src);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, hints));
}
