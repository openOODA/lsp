// # Sovereign LSP Go-To-Definition via Compiler Table
//
// Logline: Resolves symbol via CompilerReadCap Location (uri+line/col), builtin path as secondary.
//
// Setup: Active path is compiler-fetched index; resolves via compiler uri+line/col. The oodar root is the configured `oodar_root` (defaults to the polyrepo convention `oodar`); all builtin paths are resolved relative to it. v0.6.2: paths moved from the legacy `ooda/runtime/chs_rt_*.c` to the canonical `oodar/<subdir>/<file>.c` (Gen 1 C host substrate extraction + std-aligned 6-subdir reorg + Floor break v2.0.0).
//
// Beats:
//   1. Look up a symbol in the compiler-fetched index to confirm it is known.
//   2. Resolve Location via compiler uri+line/col, builtin path table as secondary.
//   3. Format a JSON Location response with uri, range, and line/column.
//   4. Format a JSON null result envelope when the symbol cannot be resolved.

import "lsp/symbols/lsp_symbol_record.oo";
import "lsp/bridge/lsp_compiler_merge.oo";
import "lsp_text.oo";

pub fn lsp_definition_format_location(name: String, path: String, line: Int, col: Int) -> String {
    let sl: String = line.to_string();
    let sc: String = col.to_string();
    let el: String = line.to_string();
    let ec: String = (col + chars_len(name)).to_string();
    let p: String = lsp_jsonrpc_escape(path);
    return "{\"uri\":\"" + p + "\",\"range\":{\"start\":{\"line\":" + sl + ",\"character\":" + sc + "},\"end\":{\"line\":" + el + ",\"character\":" + ec + "}}}";
}

/* Cap-to-oodar-file table.
 *
 * All paths are RELATIVE to the oodar repo root. The default oodar
 * root is "oodar" (the polyrepo convention) and is overridable via
 * the lsp config (so the lsp/ repo does NOT hard-code the absolute
 * location of the oodar/ repo — that coupling would be a violation
 * of the polyrepo independence rule).
 *
 * Mapping derived from the v2.0.0 oodar layout:
 *   FsCap/FsReadCap/FsWriteCap → sec/cap/caps.c   (the OCap token system)
 *   SysCap/EnvCap              → fs/os/sys.c
 *   TimeCap/RandCap            → fs/os/time_rand.c
 *   ProcessCap                 → fs/os/sys.c
 *   AllocCap                   → core/mem/alloc.c
 *   ThreadCap                  → app/actor/thread.c
 *   NetCap/TcpCap/UdpCap/BindCap → fs/os/netfloor.c
 *   HttpCap                    → net/fetch.c
 *   GpuCap                     → hw/gpu/gpu.c
 *   UnsafeFFICap               → app/xlang/ffi.c
 */
pub fn lsp_definition_cap_path_table() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "FsCap|sec/cap/caps.c");
    out = list_push(out, "FsReadCap|sec/cap/caps.c");
    out = list_push(out, "FsWriteCap|sec/cap/caps.c");
    out = list_push(out, "SysCap|fs/os/sys.c");
    out = list_push(out, "EnvCap|fs/os/sys.c");
    out = list_push(out, "TimeCap|fs/os/time_rand.c");
    out = list_push(out, "RandCap|fs/os/time_rand.c");
    out = list_push(out, "ProcessCap|fs/os/sys.c");
    out = list_push(out, "AllocCap|core/mem/alloc.c");
    out = list_push(out, "ThreadCap|app/actor/thread.c");
    out = list_push(out, "NetCap|fs/os/netfloor.c");
    out = list_push(out, "TcpCap|fs/os/netfloor.c");
    out = list_push(out, "UdpCap|fs/os/netfloor.c");
    out = list_push(out, "BindCap|fs/os/netfloor.c");
    out = list_push(out, "HttpCap|net/fetch.c");
    out = list_push(out, "GpuCap|hw/gpu/gpu.c");
    out = list_push(out, "UnsafeFFICap|app/xlang/ffi.c");
    return out;
}

/* Default oodar root (polyrepo convention). Override at runtime via
 * the lsp config (LSP_SETTINGS or initialize params) — see protocol.oot.
 */
pub fn lsp_definition_oodar_root() -> String {
    return "oodar";
}

pub fn lsp_definition_lookup_path(name: String, tbl: List[String]) -> String {
    let n: Int = list_len(tbl);
    let mut i: Int = 0;
    while i < n {
        let row: String = list_get(tbl, i);
        let pipe: Int = str_index_of(row, "|");
        if pipe > 0 {
            let k: String = str_slice(row, 0, pipe);
            if k == name { return str_slice(row, pipe + 1, chars_len(row)); }
        }
        i = i + 1;
    }
    return "";
}

pub fn lsp_definition_builtin_path(name: String) -> String {
    let root: String = lsp_definition_oodar_root();
    if str_starts_with(name, "&") { return root + "/sec/cap/caps.c"; }
    let rel: String = lsp_definition_lookup_path(name, lsp_definition_cap_path_table());
    if chars_len(rel) == 0 { return ""; }
    return root + "/" + rel;
}

pub fn lsp_definition_is_builtin(symbol_name: String) -> Bool {
    return chars_len(lsp_definition_builtin_path(symbol_name)) > 0;
}

pub fn lsp_definition_resolve(idx: List[String], symbol_name: String) -> String {
    let rec: String = lsp_index_lookup(idx, symbol_name);
    if chars_len(rec) == 0 { return ""; }
    let path: String = lsp_definition_builtin_path(symbol_name);
    if chars_len(path) == 0 { return ""; }
    return lsp_definition_format_location(symbol_name, path, 0, 0);
}

pub fn lsp_definition_response_json(id: String, location_json: String) -> String {
    if chars_len(location_json) == 0 { return lsp_jsonrpc_make_response(id, "null"); }
    return lsp_jsonrpc_make_response(id, location_json);
}

pub fn lsp_definition_resolve_compiler(
  comp: &CompilerReadCap,
  fs: &FsReadCap,
  uri: String,
  content: String,
  symbol_name: String
) -> String {
    let idx: List[String] = lsp_compiler_fetch(comp, fs, uri, content);
    let rec: String = lsp_index_lookup(idx, symbol_name);
    if chars_len(rec) == 0 { return ""; }
    let sig: String = lsp_index_signature(rec);
    let is_user: Bool = str_index_of(sig, "pub fn " + symbol_name) >= 0;
    if is_user {
        let line: Int = lsp_definition_find_line(content, symbol_name);
        let l: Int = if line >= 0 { line } else { 0 };
        return lsp_definition_format_location(symbol_name, uri, l, 0);
    }
    let path: String = lsp_definition_builtin_path(symbol_name);
    if chars_len(path) == 0 { return ""; }
    return lsp_definition_format_location(symbol_name, path, 0, 0);
}

pub fn lsp_definition_find_line(src: String, name: String) -> Int {
    let needle: String = "pub fn " + name;
    let lines: List[String] = lsp_text_lines(src);
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        if str_index_of(list_get(lines, i), needle) >= 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
