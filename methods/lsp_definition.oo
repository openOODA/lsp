// # Sovereign LSP Go-To-Definition
//
// Logline: Resolves a symbol to a Location: pub fn/struct/enum/type in the open file, or oodar grant file from the loaded cap table.
//
// Setup: Cap paths come only from symbols/lsp_cap_table.oo rows. Empty rows yield null. No hard-coded table.
//
// Beats:
//   1. Format a JSON Location with uri, range, line, and column.
//   2. Resolve a capability token through the loaded cap table + oodar_root.
//   3. Resolve a user pub fn by line scan of the open document.
//   4. Return a JSON-RPC result envelope, or null when unresolved.

import "lsp/symbols/lsp_symbol_record.oo";
import "lsp/symbols/lsp_cap_table.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp_text.oo";
import "lsp/bridge/lsp_compiler_merge.oo";

pub fn lsp_definition_format_location(name: String, path: String, line: Int, col: Int) -> String {
    let sl: String = line.to_string();
    let sc: String = col.to_string();
    let el: String = line.to_string();
    let ec: String = (col + chars_len(name)).to_string();
    let p: String = lsp_jsonrpc_escape(path);
    return "{\"uri\":\"" + p + "\",\"range\":{\"start\":{\"line\":" + sl + ",\"character\":" + sc + "},\"end\":{\"line\":" + el + ",\"character\":" + ec + "}}}";
}

pub fn lsp_definition_builtin_path(name: String, rows: List[String], oodar_root: String) -> String {
    if chars_len(oodar_root) == 0 { return ""; }
    let rel: String = lsp_cap_table_lookup(rows, name);
    if chars_len(rel) == 0 { return ""; }
    return oodar_root + "/" + rel;
}

pub fn lsp_definition_find_line(src: String, name: String) -> Int {
    return lsp_compiler_find_line(src, name);
}

pub fn lsp_definition_resolve_in_doc(
    idx: List[String],
    rows: List[String],
    oodar_root: String,
    name: String,
    uri: String,
    src: String
) -> String {
    let line: Int = lsp_definition_find_line(src, name);
    if line >= 0 {
        return lsp_definition_format_location(name, uri, line, 0);
    }
    let rec: String = lsp_index_lookup(idx, name);
    if chars_len(rec) == 0 { return ""; }
    let path: String = lsp_definition_builtin_path(name, rows, oodar_root);
    if chars_len(path) == 0 { return ""; }
    return lsp_definition_format_location(name, path, 0, 0);
}

pub fn lsp_definition_response_json(id: String, location_json: String) -> String {
    if chars_len(location_json) == 0 { return lsp_jsonrpc_make_response(id, "null"); }
    return lsp_jsonrpc_make_response(id, location_json);
}
