// # LSP Signature Help
//
// Logline: At a call site, look up the callee in the index and report the active parameter.
//
// Setup: Pure. Walks backward from the cursor to the unmatched `(`.
//
// Beats:
//   1. Find the ident before the current argument list.
//   2. Split the index signature's parameter list on top-level commas.
//   3. activeParameter is the comma count in the current call.

import "lsp/symbols/lsp_symbol_record.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp_text.oo";

fn lsp_sig_skip_str_back(src: String, i0: Int) -> Int {
    let mut i: Int = i0;
    while i >= 0 {
        if char_at(src, i) == "\"" {
            let mut b: Int = 0;
            let mut p: Int = i - 1;
            while p >= 0 && char_at(src, p) == "\\" {
                b = b + 1;
                p = p - 1;
            }
            if b % 2 == 0 { return i - 1; }
        }
        i = i - 1;
    }
    return 0 - 1;
}

pub fn lsp_sig_callee(src: String, off: Int) -> String {
    let mut i: Int = off - 1;
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    while i >= 0 {
        let c: String = char_at(src, i);
        if in_str {
            if c == "\"" { i = lsp_sig_skip_str_back(src, i); in_str = false; continue; }
            i = i - 1;
            continue;
        }
        if c == "\"" { in_str = true; i = i - 1; continue; }
        if c == ")" { depth = depth + 1; }
        else if c == "(" {
            if depth == 0 {
                let mut k: Int = i;
                while k > 0 && (char_at(src, k - 1) == " " || char_at(src, k - 1) == "\t") { k = k - 1; }
                let mut s: Int = k;
                while s > 0 && lsp_text_is_ident_char(char_at(src, s - 1)) { s = s - 1; }
                return str_slice(src, s, k);
            }
            depth = depth - 1;
        }
        i = i - 1;
    }
    return "";
}

pub fn lsp_sig_active(src: String, off: Int) -> Int {
    let mut i: Int = off - 1;
    let mut depth: Int = 0;
    let mut commas: Int = 0;
    let mut in_str: Bool = false;
    while i >= 0 {
        let c: String = char_at(src, i);
        if in_str {
            if c == "\"" { i = lsp_sig_skip_str_back(src, i); in_str = false; continue; }
            i = i - 1;
            continue;
        }
        if c == "\"" { in_str = true; i = i - 1; continue; }
        if c == ")" { depth = depth + 1; }
        else if c == "(" {
            if depth == 0 { return commas; }
            depth = depth - 1;
        } else if c == "," && depth == 0 { commas = commas + 1; }
        i = i - 1;
    }
    return 0;
}

pub fn lsp_sig_params(sig: String) -> List[String] {
    let mut out: List[String] = list_new();
    let a: Int = str_index_of(sig, "(");
    let b: Int = str_index_of(sig, ")");
    if a < 0 || b <= a { return out; }
    let inner: String = str_slice(sig, a + 1, b);
    let n: Int = chars_len(inner);
    if n == 0 { return out; }
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut depth: Int = 0;
    while i <= n {
        let c: String = if i < n { char_at(inner, i) } else { ","; }
        if c == "(" { depth = depth + 1; }
        else if c == ")" { depth = depth - 1; }
        else if (c == "," && depth == 0) || i == n {
            let p: String = lsp_text_trim(str_slice(inner, start, i));
            if chars_len(p) > 0 { out = list_push(out, p); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

pub fn lsp_signature_json(idx: List[String], src: String, line: Int, col: Int) -> String {
    let ln: String = lsp_text_line_at(src, line);
    let ccol: Int = lsp_text_utf16_to_char(ln, col);
    let off: Int = lsp_text_index_at(src, line, col);
    let name: String = lsp_sig_callee(src, off);
    if chars_len(name) == 0 { return "null"; }
    let rec: String = lsp_index_lookup(idx, name);
    if chars_len(rec) == 0 { return "null"; }
    let sig: String = lsp_index_signature(rec);
    let ps: List[String] = lsp_sig_params(sig);
    let mut par: String = "";
    let pn: Int = list_len(ps);
    let mut i: Int = 0;
    while i < pn {
        if i > 0 { par = par + ","; }
        par = par + "{\"label\":\"" + lsp_jsonrpc_escape(list_get(ps, i)) + "\"}";
        i = i + 1;
    }
    let act: Int = lsp_sig_active(src, off);
    if ccol < 0 { return "null"; }
    return "{\"signatures\":[{\"label\":\"" + lsp_jsonrpc_escape(sig) + "\",\"parameters\":[" + par + "]}],\"activeSignature\":0,\"activeParameter\":" + act.to_string() + "}";
}

pub fn lsp_signature_handle(id: String, idx: List[String], src: String, line: Int, col: Int) -> String {
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, lsp_signature_json(idx, src, line, col)));
}
