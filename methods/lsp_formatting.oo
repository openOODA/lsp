// # LSP Document Formatting & Symbols
//
// Logline: Trims trailing whitespace and extracts pub fn/struct/enum/type symbols for documentSymbol.
//
// Setup: Pure string manipulation functions without external capability requirements.
//
// Beats:
//   1. Strip trailing whitespace per line for textDocument/formatting.
//   2. Extract pub fn (12), struct (23), enum (10), type (26) for documentSymbol.
//   3. Handle LSP formatting response generation.
//   4. Handle LSP document symbol response generation.

import "lsp/wire/lsp_json_encode.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp_text.oo";
import "lsp/bridge/lsp_compiler_merge.oo";

pub fn lsp_formatting_strip_trailing_ws(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut line_start: Int = 0;
    while i < n {
        if char_at(src, i) == "\n" {
            let mut end: Int = i;
            while end > line_start {
                let c: String = char_at(src, end - 1);
                if c == " " || c == "\t" || c == "\r" { end = end - 1; } else { break; }
            }
            out = out + str_slice(src, line_start, end) + "\n";
            i = i + 1;
            line_start = i;
        } else {
            i = i + 1;
        }
    }
    if line_start < n {
        let mut end: Int = n;
        while end > line_start {
            let c: String = char_at(src, end - 1);
            if c == " " || c == "\t" || c == "\r" { end = end - 1; } else { break; }
        }
        out = out + str_slice(src, line_start, end);
    }
    return out;
}

pub fn lsp_formatting_expand_tabs(src: String) -> String {
    let n: Int = chars_len(src);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(src, i);
        if c == "\t" { out = out + "    "; } else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn lsp_formatting_handle_formatting(id: String, uri: String, src: String) -> String {
    let normalized: String = lsp_formatting_expand_tabs(lsp_formatting_strip_trailing_ws(src));
    let esc: String = lsp_jsonrpc_escape(normalized);
    let end_line: Int = lsp_text_count_lines(src);
    let end_line_s: String = end_line.to_string();
    let body: String = "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":" + end_line_s + ",\"character\":0}},\"newText\":\"" + esc + "\"}]";
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, body));
}

fn lsp_formatting_ws_col(line: String) -> Int {
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    let mut col: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c != " " && c != "\t" { return col; }
        col = col + lsp_text_utf16_width(c);
        i = i + 1;
    }
    return col;
}

fn lsp_formatting_sym_json(uri: String, name: String, kind: String, line: Int, col: Int) -> String {
    let name_esc: String = lsp_json_escape(name);
    let ln: String = line.to_string();
    let cn: String = col.to_string();
    return "{\"name\":\"" + name_esc + "\",\"kind\":" + kind + ",\"location\":{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":" + ln + ",\"character\":" + cn + "},\"end\":{\"line\":" + ln + ",\"character\":" + cn + "}}}}";
}

pub fn lsp_formatting_extract_doc_symbols(uri: String, src: String) -> String {
    let lines: List[String] = lsp_text_lines(src);
    let n: Int = list_len(lines);
    let mut out: String = "";
    let esc_uri: String = lsp_json_escape(uri);
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        let col: Int = lsp_formatting_ws_col(line);
        let fnm: String = lsp_compiler_pub_fn_name(line);
        let sn: String = lsp_compiler_pub_kind_name(line, "pub struct ", "Struct");
        let en: String = lsp_compiler_pub_kind_name(line, "pub enum ", "Enum");
        let tn: String = lsp_compiler_pub_kind_name(line, "pub type ", "Type");
        let mut one: String = "";
        if chars_len(fnm) > 0 { one = lsp_formatting_sym_json(esc_uri, fnm, "12", i, col); }
        else if chars_len(sn) > 0 { one = lsp_formatting_sym_json(esc_uri, sn, "23", i, col); }
        else if chars_len(en) > 0 { one = lsp_formatting_sym_json(esc_uri, en, "10", i, col); }
        else if chars_len(tn) > 0 { one = lsp_formatting_sym_json(esc_uri, tn, "26", i, col); }
        if chars_len(one) > 0 {
            if chars_len(out) > 0 { out = out + ","; }
            out = out + one;
        }
        i = i + 1;
    }
    return "[" + out + "]";
}

pub fn lsp_formatting_symbol_kind_function() -> String { return "12"; }

pub fn lsp_formatting_handle_document_symbol(id: String, uri: String, src: String) -> String {
    let body: String = lsp_formatting_extract_doc_symbols(uri, src);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, body));
}
