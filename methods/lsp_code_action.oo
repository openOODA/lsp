// # LSP Code Action - Live Cap Attenuation
//
// Logline: Generates a quick-fix only for E_EM_PINS: delete the Floor/Thrust/Patch line.
//
// Setup: Maps only the code that has an honest edit. WEIGHT and PS have no edit that fixes them.
//
// Beats:
//   1. Parse the first diagnostic object out of context.diagnostics.
//   2. Resolve E_EM_PINS to a quickfix whose newText is empty (delete the range).
//   3. Serialize the action list to JSON. Unknown codes yield [].

import "lsp/types/lsp_payload.oo";
import "lsp_text.oo";
import "lsp/wire/lsp_jsonrpc.oo";

fn lsp_code_action_first_array_object(arr: String) -> String {
    let n: Int = chars_len(arr);
    let mut i: Int = 0;
    i = lsp_text_skip_ws(arr, i);
    if i < n && char_at(arr, i) == "[" {
        i = i + 1;
    }
    i = lsp_text_skip_ws(arr, i);
    if i >= n || char_at(arr, i) != "{" {
        return "";
    }
    let start: Int = i;
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(arr, i);
        if in_str {
            if esc {
                esc = false;
            } else if c == "\\" {
                esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return str_slice(arr, start, i + 1);
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn lsp_code_action_parse_diagnostic(params: String) -> LspDiagnostic {
    let ctx: String = lsp_jsonrpc_extract_object(params, "context");
    let diags_arr: String = lsp_jsonrpc_extract_object(ctx, "diagnostics");
    let first: String = lsp_code_action_first_array_object(diags_arr);
    let code: String = lsp_jsonrpc_extract_string(first, "code");
    let rng: String = lsp_jsonrpc_extract_object(first, "range");
    let start: String = lsp_jsonrpc_extract_object(rng, "start");
    let end: String = lsp_jsonrpc_extract_object(rng, "end");
    let sl: Int = lsp_jsonrpc_extract_int(start, "line");
    let sc: Int = lsp_jsonrpc_extract_int(start, "character");
    let el: Int = lsp_jsonrpc_extract_int(end, "line");
    let ec: Int = lsp_jsonrpc_extract_int(end, "character");
    return lsp_diagnostic_new(sl, sc, el, ec, 1, code, "", "openOODA");
}

pub fn lsp_code_action_resolve(diag: &LspDiagnostic) -> List[LspCodeAction] {
    let mut actions: List[LspCodeAction] = list_new();
    let code: String = diag.code;
    let sl: Int = diag.start_line;
    let sc: Int = diag.start_col;
    let el: Int = diag.end_line;
    let ec: Int = diag.end_col;

    if code == "E_EM_PINS" {
        let title: String = "E-M: Remove Floor/Thrust/Patch pins from the header";
        actions = list_push(actions, lsp_action_simple_new(title, "quickfix", "", sl, sc, el, ec));
    }

    return actions;
}

pub fn lsp_code_action_to_json(action: &LspCodeAction, uri: String) -> String {
    let ttl: String = lsp_jsonrpc_escape(lsp_code_action_title(action));
    let knd: String = lsp_jsonrpc_escape(lsp_code_action_kind(action));
    let edt: String = lsp_jsonrpc_escape(lsp_code_action_edit(action));
    let u: String = lsp_jsonrpc_escape(uri);
    let sl: String = action.start_line.to_string();
    let sc: String = action.start_col.to_string();
    let el: String = action.end_line.to_string();
    let ec: String = action.end_col.to_string();
    return "{\"title\":\"" + ttl + "\",\"kind\":\"" + knd + "\",\"edit\":{\"changes\":{\"" + u + "\":[{\"range\":{\"start\":{\"line\":" + sl + ",\"character\":" + sc + "},\"end\":{\"line\":" + el + ",\"character\":" + ec + "}},\"newText\":\"" + edt + "\"}]}}}";
}

pub fn lsp_code_actions_to_json(actions: List[LspCodeAction], uri: String) -> String {
    let mut out: String = "[";
    let n: Int = list_len(actions);
    let mut i: Int = 0;
    while i < n {
        if i > 0 {
            out = out + ",";
        }
        let act: LspCodeAction = list_get(actions, i);
        out = out + lsp_code_action_to_json(&act, uri);
        i = i + 1;
    }
    out = out + "]";
    return out;
}
