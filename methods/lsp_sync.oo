// # LSP Incremental Document Sync
//
// Logline: Applies textDocument/didChange contentChanges in order: ranged replace or full text.
//
// Setup: Pure. Range columns are LSP UTF-16. Missing range means the whole document.
//
// Beats:
//   1. Split contentChanges into JSON objects.
//   2. Full replace when range is absent.
//   3. Ranged replace via lsp_text_replace_range.

import "lsp_text.oo";
import "lsp/wire/lsp_jsonrpc.oo";

pub fn lsp_sync_objects(arr: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = chars_len(arr);
    let mut i: Int = lsp_text_skip_ws(arr, 0);
    if i >= n { return out; }
    if char_at(arr, i) != "[" { return out; }
    i = i + 1;
    while i < n {
        i = lsp_text_skip_ws(arr, i);
        if i >= n { break; }
        let c: String = char_at(arr, i);
        if c == "]" { break; }
        if c == "," { i = i + 1; continue; }
        if c != "{" { return list_new(); }
        let start: Int = i;
        let mut depth: Int = 0;
        let mut in_str: Bool = false;
        let mut esc: Bool = false;
        while i < n {
            let ch: String = char_at(arr, i);
            if in_str {
                if esc { esc = false; }
                else if ch == "\\" { esc = true; }
                else if ch == "\"" { in_str = false; }
            } else if ch == "\"" { in_str = true; }
            else if ch == "{" { depth = depth + 1; }
            else if ch == "}" {
                depth = depth - 1;
                if depth == 0 {
                    out = list_push(out, str_slice(arr, start, i + 1));
                    i = i + 1;
                    break;
                }
            }
            i = i + 1;
        }
    }
    return out;
}

pub fn lsp_sync_apply_one(src: String, ch: String) -> String {
    let rng: String = lsp_jsonrpc_extract_object(ch, "range");
    let text: String = lsp_jsonrpc_unescape(lsp_jsonrpc_extract_string(ch, "text"));
    if chars_len(rng) == 0 { return text; }
    let st: String = lsp_jsonrpc_extract_object(rng, "start");
    let en: String = lsp_jsonrpc_extract_object(rng, "end");
    let sl: Int = lsp_jsonrpc_extract_int(st, "line");
    let sc: Int = lsp_jsonrpc_extract_int(st, "character");
    let el: Int = lsp_jsonrpc_extract_int(en, "line");
    let ec: Int = lsp_jsonrpc_extract_int(en, "character");
    return lsp_text_replace_range(src, sl, sc, el, ec, text);
}

pub fn lsp_sync_apply_changes(src: String, changes: String) -> String {
    let objs: List[String] = lsp_sync_objects(changes);
    let n: Int = list_len(objs);
    if n == 0 { return src; }
    let mut acc: String = src;
    let mut i: Int = 0;
    while i < n {
        acc = lsp_sync_apply_one(acc, list_get(objs, i));
        i = i + 1;
    }
    return acc;
}

pub fn lsp_sync_folder_uris(arr: String) -> List[String] {
    let objs: List[String] = lsp_sync_objects(arr);
    let n: Int = list_len(objs);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let u: String = lsp_jsonrpc_extract_string(list_get(objs, i), "uri");
        if chars_len(u) > 0 { out = list_push(out, u); }
        i = i + 1;
    }
    return out;
}

pub fn lsp_merkle_root(leaves: List[String]) -> String {
    let n: Int = list_len(leaves);
    if n == 0 { return crypto_sha256_internal(""); }
    if n == 1 { return list_get(leaves, 0); }
    let mut current: List[String] = leaves;
    while list_len(current) > 1 {
        let mut next_level: List[String] = list_new();
        let cur_len: Int = list_len(current);
        let mut i: Int = 0;
        while i < cur_len {
            if i + 1 < cur_len {
                let pair: String = list_get(current, i) + list_get(current, i + 1);
                next_level = list_push(next_level, crypto_sha256_internal(pair));
            } else {
                next_level = list_push(next_level, list_get(current, i));
            }
            i = i + 2;
        }
        current = next_level;
    }
    return list_get(current, 0);
}

pub fn lsp_merkle_compute_doc(src: String) -> String {
    let mut leaves: List[String] = list_new();
    let n: Int = chars_len(src);
    if n == 0 {
        leaves = list_push(leaves, crypto_sha256_internal(""));
    } else {
        let mut start: Int = 0;
        let mut i: Int = 0;
        while i <= n {
            if i == n || char_at(src, i) == "\n" {
                leaves = list_push(leaves, crypto_sha256_internal(str_slice(src, start, i)));
                start = i + 1;
            }
            i = i + 1;
        }
    }
    return lsp_merkle_root(leaves);
}

pub fn lsp_sync_apply_changes_merkle(src: String, changes: String) -> List[String] {
    let new_src: String = lsp_sync_apply_changes(src, changes);
    let root: String = lsp_merkle_compute_doc(new_src);
    let mut res: List[String] = list_new();
    res = list_push(res, new_src);
    res = list_push(res, root);
    return res;
}

pub fn lsp_sync_ast_cache_check(cached_hash: String, src: String) -> Bool {
    if chars_len(cached_hash) == 0 { return false; }
    let cur_hash: String = lsp_merkle_compute_doc(src);
    return cached_hash == cur_hash;
}

