// # LSP Source Text Utilities
//
// Logline: Extract lines, count lines, trim, skip whitespace, and find the word at a cursor position for completion, hover, definition, JSON framing, and stdlib scanning.
//
// Setup: Pure string manipulation. No filesystem or process capability required.
//
// Beats:
//   1. Extract a single line by index from multi-line source text.
//   2. Split multi-line source text into a List[String] of lines.
//   3. Count lines in a multi-line source text.
//   4. Trim leading/trailing ASCII whitespace from a string.
//   5. Skip leading ASCII whitespace from a string starting at an offset.
//   6. Compute the identifier or reference under the cursor.
//   7. Classify a character as digit, identifier-character, or none.

pub fn lsp_text_line_at(src: String, line: Int) -> String {
    let n: Int = chars_len(src);
    let mut i: Int = 0;
    let mut ln: Int = 0;
    let mut start: Int = 0;
    while i < n {
        if char_at(src, i) == "\n" {
            if ln == line { return str_slice(src, start, i); }
            ln = ln + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if ln == line { return str_slice(src, start, n); }
    return "";
}

pub fn lsp_text_lines(src: String) -> List[String] {
    let n: Int = chars_len(src);
    let mut out: List[String] = list_new();
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(src, i) == "\n" {
            out = list_push(out, str_slice(src, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n { out = list_push(out, str_slice(src, start, n)); }
    else if n == 0 { out = list_push(out, ""); }
    return out;
}

pub fn lsp_text_count_lines(src: String) -> Int {
    let n: Int = chars_len(src);
    if n == 0 { return 0; }
    let mut count: Int = 1;
    let mut i: Int = 0;
    while i < n {
        if char_at(src, i) == "\n" { count = count + 1; }
        i = i + 1;
    }
    return count;
}

pub fn lsp_text_trim(s: String) -> String {
    let n: Int = chars_len(s);
    let mut start: Int = 0;
    while start < n {
        let c: String = char_at(s, start);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { start = start + 1; }
        else { break; }
    }
    let mut end: Int = n;
    while end > start {
        let c: String = char_at(s, end - 1);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { end = end - 1; }
        else { break; }
    }
    if end <= start { return ""; }
    return str_slice(s, start, end);
}

pub fn lsp_text_skip_ws(s: String, i0: Int) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = i0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\r" || c == "\n" { i = i + 1; }
        else { break; }
    }
    return i;
}

pub fn lsp_text_is_digit(c: String) -> Bool {
    if chars_len(c) != 1 { return false; }
    let code: Int = byte_at(c, 0);
    return code >= 48 && code <= 57;
}

pub fn lsp_text_is_ident_char(c: String) -> Bool {
    if chars_len(c) != 1 { return false; }
    let code: Int = byte_at(c, 0);
    let is_letter: Bool = (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
    let is_digit: Bool = code >= 48 && code <= 57;
    return is_letter || is_digit || code == 95;
}

pub fn lsp_text_word_at(src: String, line: Int, col: Int) -> String {
    let ln: String = lsp_text_line_at(src, line);
    let n: Int = chars_len(ln);
    if col < 0 || col > n { return ""; }
    let mut start: Int = col;
    while start > 0 {
        let c: String = char_at(ln, start - 1);
        if lsp_text_is_ident_char(c) { start = start - 1; }
        else if c == "&" { start = start - 1; break; }
        else { break; }
    }
    let mut end: Int = col;
    while end < n {
        let c: String = char_at(ln, end);
        if lsp_text_is_ident_char(c) { end = end + 1; }
        else { break; }
    }
    return str_slice(ln, start, end);
}

pub fn lsp_text_utf16_width(c: String) -> Int {
    if chars_len(c) == 0 { return 0; }
    let b: Int = byte_at(c, 0);
    if b >= 240 { return 2; }
    return 1;
}

pub fn lsp_text_utf16_to_char(line: String, u16col: Int) -> Int {
    let n: Int = chars_len(line);
    if u16col <= 0 { return 0; }
    let mut u: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if u >= u16col { return i; }
        u = u + lsp_text_utf16_width(char_at(line, i));
        i = i + 1;
    }
    return n;
}

pub fn lsp_text_completion_prefix(src: String, line: Int, col: Int) -> String {
    let ln: String = lsp_text_line_at(src, line);
    let ccol: Int = lsp_text_utf16_to_char(ln, col);
    let word: String = lsp_text_word_at(src, line, ccol);
    if str_starts_with(word, "&") { return str_slice(word, 1, chars_len(word)); }
    return word;
}
