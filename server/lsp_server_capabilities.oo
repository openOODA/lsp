// # LSP Server Capabilities Declaration
//
// Logline: Returns the capabilities object advertised in initialize. Only implemented methods appear.
//
// Setup: Pure constant. serverInfo is assembled in the initialize handler from lsp_facade_version().
//
// Beats:
//   1. Advertise full-document sync with openClose (didOpen and didClose are dispatched).
//   2. Advertise completion without resolveProvider (completionItem/resolve is not implemented).
//   3. Do not advertise workspaceFolders (no folder handler exists).

pub fn lsp_server_capabilities_object() -> String {
    return "{\"textDocumentSync\":{\"openClose\":true,\"change\":1},\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\"&\",\":\"]},\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"documentFormattingProvider\":true,\"codeActionProvider\":true,\"documentLinkProvider\":{\"resolveProvider\":false},\"inlayHintProvider\":true,\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false},\"executeCommandProvider\":{\"commands\":[\"ooda.lsp.version\",\"ooda.lsp.indexSize\",\"ooda.lsp.echo\"]}}";
}
