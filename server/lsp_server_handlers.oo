// # LSP Per-Method Handlers
//
// Logline: Per-method handlers that take parsed request fields and return a framed JSON-RPC body.
//
// Setup: Lifecycle, document diagnostics, completion, hover, definition, and index refresh.
//
// Beats:
//   1. initialize returns capabilities plus serverInfo.version from lsp_facade_version().
//   2. didOpen and didChange publish the three live E-M diagnostics.
//   3. definition uses the open document and the loaded cap table.
//   4. didClose lives in methods/lsp_diagnostics.oo with the other diagnostic emitters.

import "lsp/types/lsp_types.oo";
import "lsp/symbols/lsp_symbol_record.oo";
import "lsp/methods/lsp_completion_codec.oo";
import "lsp/methods/lsp_hover.oo";
import "lsp/methods/lsp_definition.oo";
import "lsp/methods/lsp_diagnostics.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp/symbols/lsp_stdlib.oo";
import "lsp_server_capabilities.oo";
import "lsp_version.oo";

pub fn lsp_server_handle_completion(id: String, idx: List[String], prefix: String) -> String {
    let recs: List[String] = lsp_index_prefix(idx, prefix);
    let items: String = lsp_index_records_to_completion_json(recs);
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, "{\"isIncomplete\":false,\"items\":[" + items + "]}"));
}

pub fn lsp_server_handle_hover(id: String, idx: List[String], sym: String, line: Int, col: Int, src: String) -> String {
    let hov: String = lsp_hover_from_index(idx, sym, id, line, col, src);
    return lsp_jsonrpc_frame(hov);
}

pub fn lsp_server_handle_definition(id: String, idx: List[String], rows: List[String], sym: String, uri: String, src: String, oodar_root: String) -> String {
    let loc: String = lsp_definition_resolve_in_doc(idx, rows, oodar_root, sym, uri, src);
    let resp: String = lsp_definition_response_json(id, loc);
    return lsp_jsonrpc_frame(resp);
}

pub fn lsp_server_handle_did_open(uri: String, src: String) -> String { return lsp_server_emit_diagnostics(uri, src); }
pub fn lsp_server_handle_did_change(uri: String, src: String) -> String { return lsp_server_emit_diagnostics(uri, src); }

pub fn lsp_server_handle_diagnostic(id: String, uri: String, src: String) -> String {
    let diags: String = lsp_server_extract_diags(uri, src);
    let resp: String = "{\"items\":[" + diags + "]}";
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, resp));
}

pub fn lsp_server_refresh_index(fs: &FsReadCap, r: String) -> List[String] {
    let rt: String = lsp_stdlib_find_root(fs, r);
    return lsp_stdlib_scan(fs, rt);
}

pub fn lsp_server_handle_initialize(id: String) -> String {
    let caps: String = lsp_server_capabilities_object();
    let ver: String = lsp_facade_version();
    let body: String = "{\"capabilities\":" + caps + ",\"serverInfo\":{\"name\":\"openooda-lsp\",\"version\":\"" + ver + "\"}}";
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, body));
}

pub fn lsp_server_handle_shutdown(id: String) -> String {
    return lsp_jsonrpc_frame(lsp_jsonrpc_make_response(id, "null"));
}
