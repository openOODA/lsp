// # LSP Server Workspace Trust Guards
//
// Logline: Validates every URI against the workspace root, traversal, and denied system paths before a handler runs.
//
// Setup: Pure guards. Notifications that fail are dropped. Requests that fail get -32602.
//
// Beats:
//   1. Extract textDocument.uri and textDocument.text only. No params-level fallback.
//   2. Reject text larger than 4MB. Do not truncate.
//   3. Reject .. path segments and URIs outside root.
//   4. Deny /proc, /dev, /etc, and /root as URI path prefixes.
//   5. Stamp session state while preserving oodar_root and cap_rows.

import "lsp/types/lsp_types.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp/symbols/lsp_e_m_concat.oo";

pub fn lsp_server_text_cap() -> Int { return lsp_em_cap_text(); }

pub fn lsp_server_text_too_large(text: String) -> Bool {
    return bytes_len(text) > lsp_server_text_cap();
}

pub fn lsp_server_extract_doc(params: String) -> LspDoc {
    let td: String = lsp_jsonrpc_extract_object(params, "textDocument");
    if chars_len(td) == 0 { return lsp_doc_new("", "", false); }
    let uri: String = lsp_jsonrpc_extract_string(td, "uri");
    let raw: String = lsp_jsonrpc_extract_string(td, "text");
    return lsp_doc_new(uri, raw, true);
}

pub fn lsp_server_uri_path(uri: String) -> String {
    if str_starts_with(uri, "file://") { return str_slice(uri, 7, chars_len(uri)); }
    return uri;
}

pub fn lsp_server_path_denied(path: String) -> Bool {
    if path == "/proc" || str_starts_with(path, "/proc/") { return true; }
    if path == "/dev" || str_starts_with(path, "/dev/") { return true; }
    if path == "/etc" || str_starts_with(path, "/etc/") { return true; }
    if path == "/root" || str_starts_with(path, "/root/") { return true; }
    return false;
}

pub fn lsp_server_uri_has_traversal(uri: String) -> Bool {
    let n: Int = chars_len(uri);
    let mut i: Int = 0;
    while i < n {
        if char_at(uri, i) == "." && i + 1 < n && char_at(uri, i + 1) == "." {
            let before: Bool = i == 0 || char_at(uri, i - 1) == "/";
            let after: Bool = i + 2 == n || char_at(uri, i + 2) == "/";
            if before && after { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn lsp_server_uri_is_under(uri: String, root: String) -> Bool {
    if chars_len(root) == 0 { return false; }
    if chars_len(uri) < chars_len(root) { return false; }
    if !str_starts_with(uri, root) { return false; }
    if chars_len(uri) == chars_len(root) { return true; }
    return char_at(uri, chars_len(root)) == "/";
}

pub fn lsp_server_uri_acceptable(uri: String, root: String) -> Bool {
    if lsp_server_uri_has_traversal(uri) { return false; }
    if lsp_server_path_denied(lsp_server_uri_path(uri)) { return false; }
    return lsp_server_uri_is_under(uri, root);
}

pub fn lsp_server_trust_check(state: LspServerState, uri: String, id: String) -> String {
    if lsp_server_uri_has_traversal(uri) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI traversal refused: " + uri));
    }
    if lsp_server_path_denied(lsp_server_uri_path(uri)) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI denied: " + uri));
    }
    if !lsp_server_uri_is_under(uri, state.root_uri) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI outside root: " + uri));
    }
    return "";
}

pub fn lsp_server_stamp(s: LspServerState, init: Bool, root: String) -> LspServerState {
    return LspServerState { is_initialized: init, root_uri: root, oodar_root: s.oodar_root };
}
