// # LSP Server Workspace Trust Guards
//
// Logline: Extracts textDocument fields and returns -32602 envelopes for untrusted URIs.
//
// Setup: Pure guards. Notifications that fail are dropped. Requests that fail get -32602.
//
// Beats:
//   1. Extract textDocument.uri and text. No params-level uri/text.
//   2. Reject text larger than 4MB. Do not truncate.
//   3. Stamp session root and the single open document.

import "lsp/types/lsp_types.oo";
import "lsp/wire/lsp_jsonrpc.oo";
import "lsp/symbols/lsp_e_m_concat.oo";
import "lsp/methods/lsp_text.oo";
import "lsp_server_uri.oo";

pub fn lsp_server_text_cap() -> Int { return lsp_em_cap_text(); }

pub fn lsp_server_text_too_large(text: String) -> Bool {
    return bytes_len(text) > lsp_server_text_cap();
}

fn lsp_server_first_object(arr: String) -> String {
    let n: Int = chars_len(arr);
    let mut i: Int = lsp_text_skip_ws(arr, 0);
    if i < n && char_at(arr, i) == "[" { i = i + 1; }
    i = lsp_text_skip_ws(arr, i);
    if i >= n || char_at(arr, i) != "{" { return ""; }
    let start: Int = i;
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(arr, i);
        if in_str {
            if esc { esc = false; }
            else if c == "\\" { esc = true; }
            else if c == "\"" { in_str = false; }
        } else if c == "\"" { in_str = true; }
        else if c == "{" { depth = depth + 1; }
        else if c == "}" {
            depth = depth - 1;
            if depth == 0 { return str_slice(arr, start, i + 1); }
        }
        i = i + 1;
    }
    return "";
}

pub fn lsp_server_extract_doc(params: String) -> LspDoc {
    let td: String = lsp_jsonrpc_extract_object(params, "textDocument");
    if chars_len(td) == 0 { return lsp_doc_new("", "", false); }
    let uri: String = lsp_jsonrpc_extract_string(td, "uri");
    let mut raw: String = lsp_jsonrpc_extract_string(td, "text");
    if chars_len(raw) == 0 {
        let ch: String = lsp_jsonrpc_extract_object(params, "contentChanges");
        raw = lsp_jsonrpc_extract_string(lsp_server_first_object(ch), "text");
    }
    return lsp_doc_new(uri, raw, true);
}

pub fn lsp_server_doc_text(state: LspServerState, d: LspDoc) -> String {
    if chars_len(d.text) > 0 { return d.text; }
    if d.uri == state.doc_uri { return state.doc_text; }
    return "";
}

pub fn lsp_server_trust_check(state: LspServerState, uri: String, id: String) -> String {
    if lsp_server_uri_has_traversal(uri) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI traversal refused: " + uri));
    }
    if lsp_server_path_denied(lsp_server_uri_path(uri)) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI denied: " + uri));
    }
    if !lsp_server_uri_is_under(uri, state.root_uri) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "URI outside root: " + uri));
    }
    return "";
}

pub fn lsp_server_request_guard(state: LspServerState, uri: String, text: String, id: String) -> String {
    let err: String = lsp_server_trust_check(state, uri, id);
    if chars_len(err) > 0 { return err; }
    if lsp_server_text_too_large(text) {
        return lsp_jsonrpc_frame(lsp_jsonrpc_make_error(id, 0 - 32602, "text exceeds 4MB"));
    }
    return "";
}

pub fn lsp_server_stamp(s: LspServerState, init: Bool, root: String) -> LspServerState {
    return LspServerState { is_initialized: init, root_uri: root, oodar_root: s.oodar_root, doc_uri: s.doc_uri, doc_text: s.doc_text };
}

pub fn lsp_server_stamp_doc(s: LspServerState, uri: String, text: String) -> LspServerState {
    return LspServerState { is_initialized: s.is_initialized, root_uri: s.root_uri, oodar_root: s.oodar_root, doc_uri: uri, doc_text: text };
}

pub fn lsp_server_clear_doc(s: LspServerState) -> LspServerState {
    return LspServerState { is_initialized: s.is_initialized, root_uri: s.root_uri, oodar_root: s.oodar_root, doc_uri: "", doc_text: "" };
}
