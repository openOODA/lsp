// # RFC 8259 JSON String Escape Helper
//
// Logline: Escapes (and unescapes) control and quote characters so LSP and JSON-RPC payloads remain standards-compliant.
//
// Setup: Pure string codec. No capability required. Unescape covers short escapes
//        plus the \u00XX forms the encoder emits; other \u stays raw (documented residual).
//
// Beats:
//   1. Encode a byte as a two-digit uppercase hex string.
//   2. Escape backslash, quote, and JSON short escapes.
//   3. Emit \u00XX for remaining C0 control bytes (0x00-0x1F).
//   4. Unescape short escapes and the six \u00XX forms above; unknown stays raw.

pub fn lsp_json_hex_byte(b: Int) -> String {
    let hex: String = "0123456789ABCDEF";
    let hi: Int = b / 16;
    let lo: Int = b % 16;
    return char_at(hex, hi) + char_at(hex, lo);
}

pub fn lsp_json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let b: Int = byte_at(c, 0);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\n"; }
        else if c == "\r" { out = out + "\\r"; }
        else if c == "\t" { out = out + "\\t"; }
        else if b >= 0 && b < 32 {
            out = out + "\\u00" + lsp_json_hex_byte(b);
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

fn lsp_json_unescape_u(s: String, i: Int) -> String {
    if i + 5 >= chars_len(s) { return ""; }
    if char_at(s, i) != "\\" { return ""; }
    if char_at(s, i + 1) != "u" { return ""; }
    let h: String = str_slice(s, i + 2, i + 6);
    if h == "000A" || h == "000a" { return "\n"; }
    if h == "000D" || h == "000d" { return "\r"; }
    if h == "0009" { return "\t"; }
    if h == "0022" { return "\""; }
    if h == "005C" || h == "005c" { return "\\"; }
    if h == "002F" || h == "002f" { return "/"; }
    return "";
}

pub fn lsp_json_unescape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c != "\\" || i + 1 >= n {
            out = out + c;
            i = i + 1;
            continue;
        }
        let e: String = char_at(s, i + 1);
        if e == "\"" { out = out + "\""; i = i + 2; continue; }
        if e == "\\" { out = out + "\\"; i = i + 2; continue; }
        if e == "/" { out = out + "/"; i = i + 2; continue; }
        if e == "n" { out = out + "\n"; i = i + 2; continue; }
        if e == "r" { out = out + "\r"; i = i + 2; continue; }
        if e == "t" { out = out + "\t"; i = i + 2; continue; }
        if e == "u" {
            let u: String = lsp_json_unescape_u(s, i);
            if chars_len(u) > 0 { out = out + u; i = i + 6; continue; }
        }
        out = out + c + e;
        i = i + 2;
    }
    return out;
}
