// # LSP Subsystem — Anchor for Agents
//
// Logline: Front door for the lsp/ directory. Re-exports the 6 functional subdirs plus the cli/ command interface.
//
// Setup: Pure structural file. Imports register the 6 subdir ANCHOR.oo files plus cli/, qa/, scripts/, docs/, examples/.
//
// Beats:
//   1. The 6 subdirs are: wire, types, server, methods, symbols, bridge.
//   2. cli/ has the standalone entry point: parses argv, runs the stdio JSON-RPC loop.
//   3. Each subdir has its own ANCHOR.oo front door.
//   4. qa/ has 8 self-test probe drivers; scripts/ has build, test, verify, release.
//   5. docs/ has LSP_SETUP.oot, protocol.oot, and client_config.oot; examples/ has 3 sample JSON-RPC pairs.
//   6. VERSION declares lsp=0.6.0 with ooda compat range and api_surface=7.

import "wire/ANCHOR.oo";
import "types/ANCHOR.oo";
import "server/ANCHOR.oo";
import "methods/ANCHOR.oo";
import "symbols/ANCHOR.oo";
import "bridge/ANCHOR.oo";
import "qa/ANCHOR.oo";
import "cli/ANCHOR.oo";
import "scripts/ANCHOR.oo";
import "docs/ANCHOR.oo";
import "examples/ANCHOR.oo";
