// # LSP Session and Frame Types
//
// Logline: Defines LspFrame, LspServerState, LspProcessResult, and LspDoc for the stdio loop and dispatcher.
//
// Setup: Pure records. Payload types live in lsp_payload.oo.
//
// Beats:
//   1. Declare LspFrame for Content-Length framing.
//   2. Declare LspServerState including the single open document.
//   3. Declare LspDoc for a textDocument extract.

type LspFrame = struct {
    body: String,
    rest: String,
    ok: Bool
};

type LspServerState = struct {
    is_initialized: Bool,
    root_uri: String,
    oodar_root: String,
    doc_uri: String,
    doc_text: String
};

type LspProcessResult = struct {
    response: String,
    new_state: LspServerState
};

type LspDoc = struct {
    uri: String,
    text: String,
    has_doc: Bool
};

pub fn lsp_frame_none() -> LspFrame {
    return LspFrame { body: "", rest: "", ok: false };
}

pub fn lsp_frame_take(body: String, rest: String) -> LspFrame {
    return LspFrame { body: body, rest: rest, ok: true };
}

pub fn lsp_frame_body(fr: &LspFrame) -> String { return fr.body; }
pub fn lsp_frame_rest(fr: &LspFrame) -> String { return fr.rest; }
pub fn lsp_frame_is_ok(fr: &LspFrame) -> Bool { return fr.ok; }

pub fn lsp_server_state_new() -> LspServerState {
    return LspServerState { is_initialized: false, root_uri: "", oodar_root: "", doc_uri: "", doc_text: "" };
}

pub fn lsp_server_state_with_oodar(s: LspServerState, oodar_root: String) -> LspServerState {
    return LspServerState { is_initialized: s.is_initialized, root_uri: s.root_uri, oodar_root: oodar_root, doc_uri: s.doc_uri, doc_text: s.doc_text };
}

pub fn lsp_process_result_new(response: String, new_state: LspServerState) -> LspProcessResult {
    return LspProcessResult { response: response, new_state: new_state };
}

pub fn lsp_doc_new(uri: String, text: String, has_doc: Bool) -> LspDoc {
    return LspDoc { uri: uri, text: text, has_doc: has_doc };
}
