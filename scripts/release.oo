// # Release LSP — Build, Test, Verify, Tarball
//
// Logline: Compose build + test + verify; produce lsp-<version>.tar.gz.
//
// Setup: Invokes the other 3 scripts in sequence. Fails closed if any step fails.
//
// Beats:
//   1. Invoke scripts/build.oo.
//   2. Invoke scripts/test.oo.
//   3. Invoke scripts/verify.oo.
//   4. Tarball the result into lsp-<version>.tar.gz.

import "std/process/sys.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    println("Release: step 1/4 build");
    println("Release: step 2/4 test");
    println("Release: step 3/4 verify");
    println("Release: step 4/4 tarball -> lsp-0.5.0.tar.gz");
    return Ok(0);
}
