// # Build LSP - Typecheck the Server Entry
//
// Logline: Runs OODA_COMPILER on lsp/cli/main.oo from OODA_FS_READDIR. Fail closed if the compiler rejects the tree.
//
// Setup: Requires OODA_COMPILER and OODA_FS_READDIR. No VERSION file. No fake compile lines.
//
// Beats:
//   1. Refuse missing compiler or repo root.
//   2. Exec `oodac run` is not a build; exec `oodac` on the entry so import expansion runs.
//   3. Return Err when the compiler exits non-zero.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    if cr.is_err() { return Err("OODA_COMPILER required"); }
    let bin: String = match cr { Ok(s) => s, Err(_) => "" };
    if chars_len(bin) == 0 { return Err("OODA_COMPILER empty"); }
    if !path_exists(fs_r, bin) { return Err("OODA_COMPILER missing"); }

    let rr: Result[String, String] = env_get(env, "OODA_FS_READDIR");
    if rr.is_err() { return Err("OODA_FS_READDIR required"); }
    let root: String = match rr { Ok(s) => s, Err(_) => "" };
    if chars_len(root) == 0 { return Err("OODA_FS_READDIR empty"); }
    if str_index_of(root, "..") >= 0 { return Err("OODA_FS_READDIR traversal"); }

    let entry: String = root + "/lsp/cli/main.oo";
    if !path_exists(fs_r, entry) { return Err("missing " + entry); }
    println("Building lsp/cli/main.oo");
    let cmd: String = "cd " + root + " && exec " + bin + " " + "lsp/cli/main.oo";
    let r: Result[String, String] = sys_exec(p, "sh", "-c", cmd);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("build failed: " + msg);
    }
    println("Build ok");
    return Ok(0);
}
