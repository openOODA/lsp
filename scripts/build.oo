// # Build LSP - Typecheck the Server Entry
//
// Logline: Runs OODA_COMPILER check on lsp/cli/main.oo from OODA_FS_READDIR. Fail closed if the compiler rejects the tree.
//
// Setup: Requires OODA_COMPILER and OODA_FS_READDIR. No VERSION file. No fake compile lines. CWD is the polyrepo root.
//
// Beats:
//   1. Refuse missing compiler, repo root, or injectable paths.
//   2. Exec argv `oodac check lsp/cli/main.oo`. No shell.
//   3. Return Err when the compiler exits non-zero.

import "lsp_script_path.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let rr: Result[String, String] = env_get(env, "OODA_FS_READDIR");
    if rr.is_err() { return Err("OODA_FS_READDIR required"); }
    let root: String = match rr { Ok(s) => s, Err(_) => "" };
    if !lsp_script_path_ok(root) { return Err("OODA_FS_READDIR path refused"); }

    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    if cr.is_err() { return Err("OODA_COMPILER required"); }
    let raw_bin: String = match cr { Ok(s) => s, Err(_) => "" };
    if !lsp_script_path_ok(raw_bin) { return Err("OODA_COMPILER path refused"); }

    let bin: String = if path_exists(fs_r, raw_bin) {
        raw_bin
    } else if path_exists(fs_r, root + "/oodac/bin/oodac") {
        root + "/oodac/bin/oodac"
    } else if path_exists(fs_r, root + "/Projects/openOODA/oodac/bin/oodac") {
        root + "/Projects/openOODA/oodac/bin/oodac"
    } else {
        raw_bin
    };
    if !path_exists(fs_r, bin) { return Err("OODA_COMPILER missing"); }

    let entry: String = if path_exists(fs_r, root + "/lsp/cli/main.oo") {
        root + "/lsp/cli/main.oo"
    } else if path_exists(fs_r, root + "/Projects/openOODA/lsp/cli/main.oo") {
        root + "/Projects/openOODA/lsp/cli/main.oo"
    } else {
        root + "/lsp/cli/main.oo"
    };
    if !path_exists(fs_r, entry) { return Err("missing " + entry); }
    println("Building lsp/cli/main.oo");
    let r: Result[String, String] = sys_exec(p, bin, "check", entry);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        return Err("build failed: " + msg);
    }
    println("Build ok");
    return Ok(0);
}
