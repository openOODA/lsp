// # LSP Compiler Bridge
//
// Logline: CompilerReadCap merge of user pub fn, struct, enum, and type names into the symbol index.
//
// Setup: stdio calls lsp_compiler_merge_table on didOpen/didChange. Uses &CompilerReadCap.
//
// Beats:
//   1. lsp_compiler_merge.oo is the live path. lsp_compile.oo walks structs/enums when emit is sound.
//   2. All files follow the 4-element Academy header and the 256-line cap.
//   3. Imports go to siblings in this subdir; cross-subdir imports use the new lsp/<subdir>/<file> path.

import "lsp_compile.oo";
import "lsp_compiler_merge.oo";
import "lsp_compiler_types.oo";
