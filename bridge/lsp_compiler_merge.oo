// # LSP Compiler Index Merge
//
// Logline: Under CompilerReadCap, add pub fn, pub struct, pub enum, and pub type names from one document.
//
// Setup: Requires &CompilerReadCap. Uses lsp_text line split. Empty text returns the index unchanged.
//
// Beats:
//   1. Split the document into lines.
//   2. Take identifiers after a leading pub fn / struct / enum / type.
//   3. Append missing names as Function, Struct, Enum, or Type records.

import "lsp/methods/lsp_text.oo";
import "lsp/symbols/lsp_symbol_record.oo";

pub fn lsp_compiler_take_ident(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut out: String = "";
    while i < n {
        let c: String = char_at(s, i);
        let code: Int = byte_at(c, 0);
        let is_alpha: Bool = (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95;
        let is_digit: Bool = code >= 48 && code <= 57;
        if i == 0 {
            if !is_alpha { return out; }
        } else {
            if !is_alpha && !is_digit { return out; }
        }
        out = out + c;
        i = i + 1;
    }
    return out;
}

pub fn lsp_compiler_pub_fn_name(line: String) -> String {
    let t: String = lsp_text_trim(line);
    if str_starts_with(t, "//") { return ""; }
    if !str_starts_with(t, "pub fn ") { return ""; }
    return lsp_compiler_take_ident(str_slice(t, 7, chars_len(t)));
}

pub fn lsp_compiler_pub_kind_name(line: String, prefix: String, kind: String) -> String {
    let t: String = lsp_text_trim(line);
    if str_starts_with(t, "//") { return ""; }
    if !str_starts_with(t, prefix) { return ""; }
    return lsp_compiler_take_ident(str_slice(t, chars_len(prefix), chars_len(t)));
}

pub fn lsp_compiler_merge_one(out: List[String], nm: String, kind: String, sig: String, uri: String) -> List[String] {
    if chars_len(nm) == 0 { return out; }
    if chars_len(lsp_index_lookup(out, nm)) != 0 { return out; }
    return lsp_index_add(out, nm, kind, sig, "declared in " + uri);
}

pub fn lsp_compiler_merge_table(c: &CompilerReadCap, idx: List[String], uri: String, text: String) -> List[String] {
    if chars_len(text) == 0 { return idx; }
    let lines: List[String] = lsp_text_lines(text);
    let n: Int = list_len(lines);
    let mut out: List[String] = idx;
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        let fnm: String = lsp_compiler_pub_fn_name(line);
        out = lsp_compiler_merge_one(out, fnm, "Function", "pub fn " + fnm + "()", uri);
        let sn: String = lsp_compiler_pub_kind_name(line, "pub struct ", "Struct");
        out = lsp_compiler_merge_one(out, sn, "Struct", "pub struct " + sn, uri);
        let tn: String = lsp_compiler_pub_kind_name(line, "pub type ", "Type");
        out = lsp_compiler_merge_one(out, tn, "Type", "pub type " + tn, uri);
        let en: String = lsp_compiler_pub_kind_name(line, "pub enum ", "Enum");
        out = lsp_compiler_merge_one(out, en, "Enum", "pub enum " + en, uri);
        i = i + 1;
    }
    return out;
}
