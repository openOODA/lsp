// # LSP Canonical Symbol Index
//
// Logline: In-memory symbol records, stdlib scan, symbol codec, E-M concat, and oodar cap table.
//
// Setup: Data layer. Methods read. Bridge writes user symbols. Cap table is loaded from oodar.
//
// Beats:
//   1. lsp_cap_table.oo parses oodar sec/cap/cap_table.json. Missing file is Err.
//   2. Canonical seed holds language tokens. Grant file paths are not in the seed.
//   3. Cross-subdir imports use the lsp/<subdir>/<file> path.

import "lsp_e_m_concat.oo";
import "lsp_stdlib.oo";
import "lsp_symbol_canonical.oo";
import "lsp_symbol_codec.oo";
import "lsp_symbol_record.oo";
import "lsp_cap_table.oo";
