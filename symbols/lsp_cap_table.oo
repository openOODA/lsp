// # LSP Capability Table from oodar cap_table.json
//
// Logline: Parses oodar sec/cap/cap_table.json into language Cap names and grant files.
//
// Setup: Requires &FsReadCap to load. No hard-coded path table. Missing file or
//        empty oodar_root is Err. Language name is derived from require or JSON name.
//
// Beats:
//   1. Derive FsReadCap from oo_cap_require_fs_read (underscore PascalCase + Cap).
//   2. Take the first .c/.h/.hip path from grantee; reserved grantees have no file.
//   3. Parse the caps array into name|rel rows. Fail closed on empty or missing JSON.
//   4. Load ${oodar_root}/sec/cap/cap_table.json. Reject traversal in oodar_root.

import "lsp/wire/lsp_jsonrpc.oo";
import "lsp/methods/lsp_text.oo";

pub fn lsp_cap_table_relpath() -> String { return "sec/cap/cap_table.json"; }

pub fn lsp_cap_table_empty() -> List[String] { return list_new(); }

pub fn lsp_cap_pascal_parts(s: String) -> String {
    let uppers: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let lowers: String = "abcdefghijklmnopqrstuvwxyz";
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut up: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "_" { up = true; i = i + 1; continue; }
        let code: Int = byte_at(c, 0);
        if code >= 65 && code <= 90 {
            let k: Int = code - 65;
            if up { out = out + char_at(uppers, k); } else { out = out + char_at(lowers, k); }
        } else if code >= 97 && code <= 122 {
            let k: Int = code - 97;
            if up { out = out + char_at(uppers, k); } else { out = out + char_at(lowers, k); }
        } else {
            out = out + c;
        }
        up = false;
        i = i + 1;
    }
    return out;
}

pub fn lsp_cap_lang_name(require: String, json_name: String) -> String {
    let prefix: String = "oo_cap_require_";
    if str_starts_with(require, prefix) {
        let rest: String = str_slice(require, chars_len(prefix), chars_len(require));
        return lsp_cap_pascal_parts(rest) + "Cap";
    }
    if chars_len(json_name) == 0 { return ""; }
    return lsp_cap_pascal_parts(json_name) + "Cap";
}

pub fn lsp_cap_grantee_file(g: String) -> String {
    let t: String = lsp_text_trim(g);
    if chars_len(t) == 0 { return ""; }
    if char_at(t, 0) == "(" { return ""; }
    let n: Int = chars_len(t);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(t, i);
        if c == " " || c == "," { break; }
        i = i + 1;
    }
    return str_slice(t, 0, i);
}

pub fn lsp_cap_json_objects(arr: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = chars_len(arr);
    let mut i: Int = lsp_text_skip_ws(arr, 0);
    if i >= n { return out; }
    if char_at(arr, i) != "[" { return out; }
    i = i + 1;
    while i < n {
        i = lsp_text_skip_ws(arr, i);
        if i >= n { break; }
        let c: String = char_at(arr, i);
        if c == "]" { break; }
        if c == "," { i = i + 1; continue; }
        if c != "{" { return list_new(); }
        let start: Int = i;
        let mut depth: Int = 0;
        let mut in_str: Bool = false;
        let mut esc: Bool = false;
        while i < n {
            let ch: String = char_at(arr, i);
            if in_str {
                if esc { esc = false; }
                else if ch == "\\" { esc = true; }
                else if ch == "\"" { in_str = false; }
            } else if ch == "\"" { in_str = true; }
            else if ch == "{" { depth = depth + 1; }
            else if ch == "}" {
                depth = depth - 1;
                if depth == 0 {
                    out = list_push(out, str_slice(arr, start, i + 1));
                    i = i + 1;
                    break;
                }
            }
            i = i + 1;
        }
    }
    return out;
}

pub fn lsp_cap_table_parse(json: String) -> Result[List[String], String] {
    if chars_len(json) == 0 { return Err("empty cap table"); }
    let arr: String = lsp_jsonrpc_extract_object(json, "caps");
    if chars_len(arr) == 0 { return Err("caps array missing"); }
    let objs: List[String] = lsp_cap_json_objects(arr);
    let n: Int = list_len(objs);
    if n == 0 { return Err("caps array empty"); }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let obj: String = list_get(objs, i);
        let name: String = lsp_jsonrpc_extract_string(obj, "name");
        let require: String = lsp_jsonrpc_extract_string(obj, "require");
        let grantee: String = lsp_jsonrpc_extract_string(obj, "grantee");
        let lang: String = lsp_cap_lang_name(require, name);
        if chars_len(lang) > 0 {
            let rel: String = lsp_cap_grantee_file(grantee);
            out = list_push(out, lang + "|" + rel);
        }
        i = i + 1;
    }
    if list_len(out) == 0 { return Err("no cap rows"); }
    return Ok(out);
}

pub fn lsp_cap_table_lookup(rows: List[String], name: String) -> String {
    let mut key: String = name;
    if str_starts_with(name, "&") { key = str_slice(name, 1, chars_len(name)); }
    let n: Int = list_len(rows);
    let mut i: Int = 0;
    while i < n {
        let row: String = list_get(rows, i);
        let pipe: Int = str_index_of(row, "|");
        if pipe > 0 {
            if str_slice(row, 0, pipe) == key {
                return str_slice(row, pipe + 1, chars_len(row));
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn lsp_cap_table_load(fs: &FsReadCap, oodar_root: String) -> Result[List[String], String] {
    if chars_len(oodar_root) == 0 { return Err("oodar_root required"); }
    if str_index_of(oodar_root, "..") >= 0 { return Err("oodar_root traversal"); }
    let path: String = oodar_root + "/" + lsp_cap_table_relpath();
    if !path_exists(fs, path) { return Err("missing " + path); }
    let rr: Result[String, String] = read_file(fs, path);
    if !rr.is_ok() { return Err("unreadable " + path); }
    let raw: String = match rr { Ok(s) => s, Err(m) => m };
    return lsp_cap_table_parse(raw);
}
